        <!-- ════════════════════════════════════════════════ -->
        <!--  JALUR 1 (y=700): M7 keluar bawah → P1 atas    -->
        <!--  Route: (180,664)→(180,700)→(870,700)→(870,740) -->
        <!-- ════════════════════════════════════════════════ -->
        <mxCell id="e_m7_p1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#546e7a;strokeWidth=1.5;endArrow=block;endFill=1;html=1;dashed=1;" edge="1" source="m7" target="p1" parent="1">
